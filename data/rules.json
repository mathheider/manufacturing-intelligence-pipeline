{
  "processes": [
    "Injection_Molding",
    "Thermoforming",
    "Compression_Molding",
    "Resin_Transfer_Molding",
    "Vacuum_Assisted_RTM",
    "Structural_Reaction_Injection_Molding",
    "Sheet_Molding_Compound",
    "Bulk_Molding_Compound",
    "Hand_Lay_up",
    "Blow_Molding",
    "Pultrusion",
    "Filament_Winding",
    "Overmolding",
    "Fused_Filament_Fabrication",
    "Stereolithography",
    "Selective_Laser_Sintering",
    "Laminated_Object_Manufacturing"
  ],
  "features": {
    "wall_thickness_mm": {
      "type": "numeric",
      "unit": "mm",
      "range": [
        0.2,
        30.0
      ]
    },
    "undercut_present": {
      "type": "boolean",
      "question": "Does this part have an undercut: a feature that would lock it inside a rigid one-piece mold, such as an internal lip, side hole, or reentrant snap feature? Surface recesses that release along the demolding direction do not count. Answer yes or no."
    },
    "draft_angle_deg": {
      "type": "numeric",
      "unit": "deg",
      "range": [
        0.0,
        10.0
      ]
    },
    "rib_count": {
      "type": "integer",
      "range": [
        0,
        50
      ]
    },
    "projected_area_cm2": {
      "type": "numeric",
      "unit": "cm^2",
      "range": [
        1,
        50000
      ]
    },
    "hollow": {
      "type": "boolean",
      "question": "Is this part a CLOSED hollow body: an enclosed vessel, tank, duct, or container whose interior is sealed or nearly sealed (like a bottle or fuel tank)? Open trays, shells, panels with recesses, and open-backed housings are NOT closed hollow bodies. Answer yes or no."
    },
    "constant_cross_section": {
      "type": "boolean",
      "question": "Does this part have one constant cross-section along its whole length, like an extruded beam, channel, or tube of uniform profile? Answer yes or no."
    },
    "axisymmetric": {
      "type": "boolean",
      "question": "Is this part a body of revolution, rotationally symmetric about one axis like a cylinder, cone, or tank? Answer yes or no."
    },
    "max_dimension_mm": {
      "type": "numeric",
      "unit": "mm",
      "range": [
        10.0,
        20000.0
      ],
      "question": "Estimate the largest overall dimension of the part (its longest bounding-box edge) in millimetres."
    },
    "production_volume": {
      "type": "integer",
      "range": [
        0,
        2
      ],
      "question": "Classify the production volume this part was made for: answer 0 for a one-off prototype, 1 for low-volume production, 2 for high-volume mass production."
    },
    "continuous_fiber_required": {
      "type": "boolean",
      "question": "Does this part structurally require continuous (unbroken, oriented) fiber reinforcement, as opposed to short chopped fiber or unreinforced plastic? Answer yes or no."
    }
  },
  "rules": {
    "Injection_Molding": {
      "forbidden_if": [
        {
          "feature": "wall_thickness_mm",
          "op": "gt",
          "value": 8.0,
          "cite": "Malloy 1994 p.151; Rosato 2000 ch.3",
          "reason": "sink/void regime above ~8 mm"
        },
        {
          "feature": "wall_thickness_mm",
          "op": "lt",
          "value": 0.3,
          "cite": "Kutz 2011 ch.11",
          "reason": "below conventional IM fill capability"
        },
        {
          "feature": "draft_angle_deg",
          "op": "lt",
          "value": 0.5,
          "cite": "Malloy 1994 p.205",
          "reason": "matched-tool ejection minimum draft"
        },
        {
          "feature": "projected_area_cm2",
          "op": "gt",
          "value": 50000,
          "cite": "Rosato & Rosato 2000 ch.4",
          "reason": "~4000-ton clamp / platen ceiling"
        },
        {
          "feature": "continuous_fiber_required",
          "op": "eq",
          "value": true,
          "cite": "Mallick 2007 ch.2 (chopped strands 3.2-12.7 mm, pp.61, 78); Rosato & Rosato 2000 ch.6",
          "reason": "melt injection carries only short/long chopped fiber; cannot place continuous reinforcement",
          "verified": {
            "date": "2026-08-04",
            "method": "web-verified source + adversarial counterexample attack (survived all attempts)",
            "n_attack_attempts": 7
          }
        },
        {
          "feature": "max_dimension_mm",
          "op": "gt",
          "value": 4000,
          "cite": "[VERIFY: Rosato & Rosato 2000 ch.4; Haitian JU 8800t specs]",
          "reason": "beyond the largest commercial platen/shot envelope (~3.5 m tie-bar daylight; 3.4 m hulls are molded)"
        }
      ]
    },
    "Thermoforming": {
      "forbidden_if": [
        {
          "feature": "hollow",
          "op": "eq",
          "value": true,
          "cite": "Throne 1996 ch.1 pp.4-6; Throne 2008 ch.1",
          "reason": "single-face draping cannot close a cavity"
        },
        {
          "feature": "wall_thickness_mm",
          "op": "gt",
          "value": 8.0,
          "cite": "Throne 1996 ch.4 pp.150-160",
          "reason": "through-thickness heating / sag limit"
        },
        {
          "feature": "wall_thickness_mm",
          "op": "lt",
          "value": 0.2,
          "cite": "Throne 2008 ch.1",
          "reason": "below commercial sheet gauge"
        },
        {
          "feature": "rib_count",
          "op": "gt",
          "value": 3,
          "cite": "Throne 1996 ch.8",
          "reason": "single-face draping cannot form transverse ribs"
        },
        {
          "feature": "undercut_present",
          "op": "eq",
          "value": true,
          "cite": "Throne 1996 ch.6",
          "reason": "single-face tool cannot release undercuts without side-action"
        },
        {
          "feature": "max_dimension_mm",
          "op": "gt",
          "value": 6000,
          "cite": "[VERIFY: Throne 2008 ch.9; MAAC/Geiss large-format specs]",
          "reason": "beyond the largest commercial sheet/oven envelope (~3.8 x 5.9 m formers; 5.8 m spa shells exist)"
        }
      ]
    },
